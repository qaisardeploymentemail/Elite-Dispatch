# Elite Truck Dispatch — lead delivery config (copy to .env on the server; keep out of git)

# SMTP (GoDaddy / secureserver.net) — the quote form emails each lead here
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465            # 465 = SSL/TLS (secure=true); use 587 for STARTTLS
SMTP_SECURE=true
SMTP_USER=info@elitetruckdispatch.com
SMTP_PASS=your-mailbox-password
LEAD_TO_EMAIL=info@elitetruckdispatch.com
LEAD_FROM=Elite Truck Dispatch <info@elitetruckdispatch.com>

# Optional: also append each lead to a Google Sheet (Apps Script web-app /exec URL)
# SHEET_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
